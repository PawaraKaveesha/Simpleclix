---
import { site, socials } from '../data/site';

const projectTypes = [
  'Website',
  'E-Commerce',
  'Web Application',
  'SEO',
  'Digital Marketing',
  'Full Digital Solution',
  'Something Else',
];

const socialIcons = {
  twitter: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.66l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z"/></svg>`,
  linkedin: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>`,
  instagram: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 1.8c-3.15 0-3.52.01-4.77.07-1.08.05-1.66.23-2.05.38-.51.2-.88.44-1.27.82-.38.38-.62.75-.82 1.27-.15.39-.33.97-.38 2.05-.06 1.25-.07 1.62-.07 4.77s.01 3.52.07 4.77c.05 1.08.23 1.66.38 2.05.2.51.44.88.82 1.27.38.38.75.62 1.27.82.39.15.97.33 2.05.38 1.25.06 1.62.07 4.77.07s3.52-.01 4.77-.07c1.08-.05 1.66-.23 2.05-.38.51-.2.88-.44 1.27-.82.38-.38.62-.75.82-1.27.15-.39.33-.97.38-2.05.06-1.25.07-1.62.07-4.77s-.01-3.52-.07-4.77c-.05-1.08-.23-1.66-.38-2.05-.2-.51-.44-.88-.82-1.27a3.4 3.4 0 0 0-1.27-.82c-.39-.15-.97-.33-2.05-.38-1.25-.06-1.62-.07-4.77-.07zm0 3.06a4.98 4.98 0 1 1 0 9.96 4.98 4.98 0 0 1 0-9.96zm0 8.21a3.23 3.23 0 1 0 0-6.46 3.23 3.23 0 0 0 0 6.46zm6.34-8.41a1.16 1.16 0 1 1-2.33 0 1.16 1.16 0 0 1 2.33 0z"/></svg>`,
  github: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.04.77 2.1 0 1.51-.01 2.73-.01 3.1 0 .31.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>`,
};
---

<section class="section contact" id="contact" aria-labelledby="contact-heading">
  <div class="grid-bg grid-bg--light" aria-hidden="true"></div>
  <div class="container contact__grid">
    <div class="contact__cta reveal">
      <span class="tag contact__tag">05 / START A PROJECT</span>
      <h2 id="contact-heading">Have a digital idea?</h2>
      <p class="contact__lead">Let's turn it into something that works.</p>
      <p class="contact__text">
        Tell us what you want to build and where you want to grow. We'll reply within one
        business day with a clear plan and honest next steps.
      </p>
      <a class="btn btn--accent contact__btn" href={`mailto:${site.email}`}>
        Talk to Simpleclix
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>

      <ul class="contact__details">
        <li>
          <span>COMPANY CONTACT</span>
          <span class="contact__name">{site.primaryContact}</span>
        </li>
        <li>
          <span>EMAIL</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <span>PHONE</span>
          <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
        </li>
      </ul>

      <ul class="contact__socials" aria-label="Follow Simpleclix">
        {socials.map((social) => (
          <li>
            <a href={social.href} aria-label={social.label} rel="noopener" target="_blank" set:html={socialIcons[social.icon]}></a>
          </li>
        ))}
      </ul>
    </div>

    <div class="contact__form-wrap reveal" style="--reveal-delay: 120ms">
      <form class="contact-form" id="contact-form" novalidate>
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" placeholder="Jane Smith" required autocomplete="name" />
          </div>
          <div class="contact-form__field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" placeholder="jane@company.com" required autocomplete="email" />
          </div>
        </div>

        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" placeholder="Company Inc." autocomplete="organization" />
          </div>
          <div class="contact-form__field">
            <label for="type">Project Type</label>
            <select id="type" name="type" required>
              <option value="" selected disabled>Select a project type</option>
              {projectTypes.map((type) => (
                <option value={type}>{type}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="contact-form__field">
          <label for="message">Message</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            placeholder="Tell us about your goals, timeline, and budget..."
            required
          ></textarea>
        </div>

        <p class="contact-form__privacy">
          By submitting, you agree to our privacy policy. We'll never share your details.
        </p>

        <button class="btn btn--accent contact-form__submit" type="submit">
          Send Message
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m22 2-7 20-4-9-9-4 20-7z"></path>
            <path d="M22 2 11 13"></path>
          </svg>
        </button>

        <p class="contact-form__status" id="form-status" role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');

  if (form && status) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const subject = encodeURIComponent(`New project enquiry from ${data.get('name')}`);
      const body = encodeURIComponent(
        [
          `Name: ${data.get('name')}`,
          `Email: ${data.get('email')}`,
          `Company: ${data.get('company') || '—'}`,
          `Project Type: ${data.get('type')}`,
          ``,
          data.get('message'),
        ].join('\n')
      );

      status.textContent = 'Thanks! Your email app will open to finish sending — or write to us directly at hello@simpleclix.com.';
      status.removeAttribute('hidden');
      form.reset();
      window.location.href = `mailto:hello@simpleclix.com?subject=${subject}&body=${body}`;
    });
  }
</script>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(36px, 5vw, 64px);
    align-items: start;
  }

  .contact__cta {
    padding-top: 8px;
  }

  .contact__tag {
    margin-bottom: 18px;
  }

  .contact__cta h2 {
    margin-bottom: 12px;
  }

  .contact__lead {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .contact__text {
    margin-bottom: 28px;
  }

  .contact__btn {
    margin-bottom: 36px;
  }

  .contact__details {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
    margin-bottom: 28px;
  }

  .contact__details li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .contact__details span {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: var(--color-muted);
  }

  .contact__details a,
  .contact__name {
    font-weight: 600;
    color: var(--color-dark);
  }

  .contact__details a:hover {
    color: var(--color-accent);
  }

  .contact__socials {
    display: flex;
    gap: 10px;
  }

  .contact__socials a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-primary-600);
    transition: background var(--transition), color var(--transition),
      transform var(--transition), border-color var(--transition);
  }

  .contact__socials a:hover {
    background: var(--color-dark);
    border-color: var(--color-dark);
    color: var(--color-white);
    transform: translateY(-3px);
  }

  .contact__socials svg {
    width: 18px;
    height: 18px;
  }

  .contact__form-wrap {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: clamp(24px, 4vw, 40px);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .contact-form__field label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-dark);
  }

  .contact-form__field input,
  .contact-form__field select,
  .contact-form__field textarea {
    width: 100%;
    padding: 13px 16px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-bg-light);
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-dark);
    transition: border-color var(--transition), box-shadow var(--transition),
      background var(--transition);
  }

  .contact-form__field input::placeholder,
  .contact-form__field textarea::placeholder {
    color: #94a3b8;
  }

  .contact-form__field input:focus,
  .contact-form__field select:focus,
  .contact-form__field textarea:focus {
    outline: none;
    border-color: var(--color-primary-600);
    background: var(--color-white);
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
  }

  .contact-form__field textarea {
    resize: vertical;
    min-height: 130px;
  }

  .contact-form__privacy {
    font-size: 0.82rem;
    color: var(--color-muted);
  }

  .contact-form__submit {
    align-self: flex-start;
  }

  .contact-form__status {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-primary-600);
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .contact-form__row {
      grid-template-columns: 1fr;
    }

    .contact-form__submit {
      align-self: stretch;
      justify-content: center;
    }
  }
</style>
