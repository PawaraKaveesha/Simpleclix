---
interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;
const wordClass = inverted ? 'logo-word logo-word--inverted' : 'logo-word';
---

<a class="logo" href="#home" aria-label="Simpleclix — home">
  <svg class="logo-mark" viewBox="0 0 48 48" width="40" height="40" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="logo-grad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#1e3a8a" />
        <stop offset="1" stop-color="#2563eb" />
      </linearGradient>
    </defs>
    <rect width="48" height="48" rx="13" fill="url(#logo-grad)" />
    <path
      d="M33.2 20.2c-.4-4-3.6-6.6-8.6-6.6-5.3 0-8.7 3-8.7 7.4 0 3.4 2.1 5.4 6.3 6.2l2.7.5c2.1.4 3.1 1.2 3.1 2.5 0 1.6-1.5 2.6-3.8 2.6-2.5 0-4.2-1-4.9-3.1-3.1.4-5.4 2.6-5.5 5.4.6 3.3 4 5.4 8.6 5.4 5.5 0 9.2-3.1 9.2-7.6 0-3.6-2.2-5.7-6.4-6.5l-2.6-.5c-1.9-.4-2.8-1.1-2.8-2.3 0-1.5 1.4-2.4 3.4-2.4 2.2 0 3.6 1 4 2.8z"
      fill="#ffffff"
    />
  </svg>
  <span class={wordClass}>Simpleclix</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-dark);
  }
  .logo:hover {
    color: var(--color-dark);
  }
  .logo-mark {
    flex-shrink: 0;
  }
  .logo-word {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-dark);
    line-height: 1;
  }
  .logo-word--inverted {
    color: var(--color-white);
  }
</style>
