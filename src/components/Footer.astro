---
import Logo from './Logo.astro';
import { site, socials } from '../data/site';
import { webServices, marketingServices } from '../data/content';

const companyLinks = [
  { label: 'About', href: '#about' },
  { label: 'Services', href: '#services' },
  { label: 'Team', href: '#team' },
  { label: 'Contact', href: '#contact' },
];

const socialIcons = {
  twitter: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.66l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z"/></svg>`,
  linkedin: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>`,
  instagram: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 1.8c-3.15 0-3.52.01-4.77.07-1.08.05-1.66.23-2.05.38-.51.2-.88.44-1.27.82-.38.38-.62.75-.82 1.27-.15.39-.33.97-.38 2.05-.06 1.25-.07 1.62-.07 4.77s.01 3.52.07 4.77c.05 1.08.23 1.66.38 2.05.2.51.44.88.82 1.27.38.38.75.62 1.27.82.39.15.97.33 2.05.38 1.25.06 1.62.07 4.77.07s3.52-.01 4.77-.07c1.08-.05 1.66-.23 2.05-.38.51-.2.88-.44 1.27-.82.38-.38.62-.75.82-1.27.15-.39.33-.97.38-2.05.06-1.25.07-1.62.07-4.77s-.01-3.52-.07-4.77c-.05-1.08-.23-1.66-.38-2.05-.2-.51-.44-.88-.82-1.27a3.4 3.4 0 0 0-1.27-.82c-.39-.15-.97-.33-2.05-.38-1.25-.06-1.62-.07-4.77-.07zm0 3.06a4.98 4.98 0 1 1 0 9.96 4.98 4.98 0 0 1 0-9.96zm0 8.21a3.23 3.23 0 1 0 0-6.46 3.23 3.23 0 0 0 0 6.46zm6.34-8.41a1.16 1.16 0 1 1-2.33 0 1.16 1.16 0 0 1 2.33 0z"/></svg>`,
  github: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.04.77 2.1 0 1.51-.01 2.73-.01 3.1 0 .31.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>`,
};
---

<footer class="footer" aria-label="Site footer">
  <div class="footer__grid-bg" aria-hidden="true"></div>
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo inverted />
        <p class="footer__desc">
          Simpleclix creates high-performance web solutions and data-driven digital
          marketing strategies that help businesses build their presence and grow online.
        </p>
        <span class="status-chip status-chip--dark">
          <span class="status-dot" aria-hidden="true"></span>
          STATUS: ACTIVE
        </span>
      </div>

      <nav class="footer__col" aria-label="Web solutions">
        <h3>Web Solutions</h3>
        <ul>
          {webServices.slice(0, 6).map((service) => (
            <li><a href="#services">{service.title}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer__col" aria-label="Digital marketing">
        <h3>Digital Marketing</h3>
        <ul>
          {marketingServices.slice(0, 6).map((service) => (
            <li><a href="#services">{service.title}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer__col footer__col--company">
        <nav aria-label="Company">
          <h3>Company</h3>
          <ul>
            {companyLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Contact">
          <h3>Contact</h3>
          <ul class="footer__contact">
            <li><span class="footer__contact-person">{site.primaryContact}</span></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="footer__socials" aria-label="Social media">
      {socials.map((social) => (
        <a href={social.href} aria-label={social.label} rel="noopener" target="_blank" set:html={socialIcons[social.icon]}></a>
      ))}
    </div>

    <div class="footer__bottom">
      <p>© 2026 Simpleclix. All rights reserved.</p>
      <ul class="footer__legal">
        <li><a href="#home">Privacy Policy</a></li>
        <li><a href="#home">Terms of Service</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--color-dark);
    color: rgba(255, 255, 255, 0.65);
    padding-top: clamp(56px, 7vw, 88px);
    padding-bottom: 28px;
  }

  .footer__grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--color-line-light) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-line-light) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 100%, #000 20%, transparent 80%);
    mask-image: radial-gradient(ellipse 90% 80% at 50% 100%, #000 20%, transparent 80%);
    opacity: 0.5;
  }

  .footer > .container {
    position: relative;
    z-index: 1;
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    gap: clamp(32px, 5vw, 56px);
    margin-bottom: 40px;
  }

  .footer__desc {
    font-size: 0.92rem;
    line-height: 1.7;
    max-width: 38ch;
    margin: 18px 0;
  }

  .footer__col h3 {
    color: var(--color-white);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .footer__col h3::after {
    content: '';
    display: block;
    width: 26px;
    height: 2px;
    background: var(--color-accent);
    margin-top: 10px;
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer__col a,
  .footer__contact-person {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .footer__col a:hover {
    color: var(--color-accent);
  }

  .footer__col--company {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .footer__socials {
    display: flex;
    gap: 10px;
    padding: 24px 0;
    border-top: 1px solid var(--color-line-light);
    border-bottom: 1px solid var(--color-line-light);
    margin-bottom: 24px;
  }

  .footer__socials a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.75);
    transition: background var(--transition), color var(--transition),
      transform var(--transition), border-color var(--transition);
  }

  .footer__socials a:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-white);
    transform: translateY(-3px);
  }

  .footer__socials svg {
    width: 17px;
    height: 17px;
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .footer__bottom p {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer__legal {
    display: flex;
    gap: 22px;
  }

  .footer__legal a {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer__legal a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 960px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 540px) {
    .footer__top {
      grid-template-columns: 1fr;
    }

    .footer__bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
