---
import { stats } from '../data/content';
---

<section class="stats" aria-label="Key performance statistics">
  <div class="container">
    <ul class="stats__grid">
      {stats.map((stat, i) => (
        <li class="stats__item reveal" style={`--reveal-delay: ${i * 80}ms`}>
          <span class="stats__label">{stat.label}</span>
          <span class="stats__value">
            {stat.value}
            <span class="stats__indicator" aria-hidden="true"></span>
          </span>
          <span class="stats__sub">{stat.sub}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stats {
    position: relative;
    background: var(--color-dark);
    border-top: 1px solid var(--color-border-dark);
    border-bottom: 1px solid var(--color-border-dark);
    padding-block: clamp(24px, 3.5vw, 40px);
  }

  .stats::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.08), transparent);
    pointer-events: none;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(16px, 2.5vw, 32px);
    position: relative;
  }

  .stats__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px 4px;
    border-right: 1px solid var(--color-border-dark);
  }

  .stats__item:last-child {
    border-right: 0;
  }

  .stats__label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .stats__value {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 600;
    color: var(--color-white);
    line-height: 1.1;
  }

  .stats__indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.5);
    animation: pulse-dot 2.4s ease-out infinite;
  }

  .stats__item:nth-child(odd) .stats__indicator {
    background: var(--color-green);
    box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5);
  }

  .stats__sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 860px) {
    .stats__grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 28px;
    }

    .stats__item:nth-child(2) {
      border-right: 0;
    }

    .stats__item {
      padding-bottom: 0;
    }
  }

  @media (max-width: 480px) {
    .stats__grid {
      grid-template-columns: 1fr;
    }

    .stats__item,
    .stats__item:nth-child(2) {
      border-right: 0;
      border-bottom: 1px solid var(--color-border-dark);
      padding-bottom: 18px;
    }

    .stats__item:last-child {
      border-bottom: 0;
    }
  }
</style>
