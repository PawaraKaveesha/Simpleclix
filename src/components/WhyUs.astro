---
import { whyUs } from '../data/content';
---

<section class="section section--dark why" id="why" aria-labelledby="why-heading">
  <div class="grid-bg grid-bg--dark" aria-hidden="true"></div>
  <div class="container">
    <div class="section-heading reveal">
      <span class="tag why__tag">WHY SIMPLECLIX</span>
      <h2 id="why-heading">Built differently.</h2>
      <p class="lead">
        Not another agency checklist — a technical partner that treats your website and
        marketing as one growth system.
      </p>
    </div>

    <ul class="why__grid">
      {whyUs.map((item, i) => (
        <li class="why__item reveal" style={`--reveal-delay: ${i * 90}ms`}>
          <div class="why__row">
            <span class="why__num">{item.number}</span>
            <span class="why__indicator" aria-hidden="true"></span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why__tag {
    margin-bottom: 18px;
  }

  .why__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(18px, 2.2vw, 24px);
  }

  .why__item {
    position: relative;
    padding: 28px 24px;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-lg);
    background: rgba(15, 23, 42, 0.55);
    transition: transform var(--transition), border-color var(--transition);
  }

  .why__item:hover {
    transform: translateY(-5px);
    border-color: rgba(37, 99, 235, 0.55);
  }

  .why__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
  }

  .why__num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.4);
  }

  .why__indicator {
    width: 22px;
    height: 3px;
    background: var(--color-accent);
  }

  .why__item:nth-child(2) .why__indicator {
    background: var(--color-primary-500);
  }

  .why__item:nth-child(3) .why__indicator {
    background: var(--color-accent);
  }

  .why__item:nth-child(4) .why__indicator {
    background: var(--color-primary-500);
  }

  .why__item h3 {
    color: var(--color-white);
    font-size: 1.08rem;
    margin-bottom: 10px;
  }

  .why__item p {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.65;
  }

  @media (max-width: 980px) {
    .why__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .why__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
