---
import { webServices, marketingServices } from '../data/content';

const icons = {
  palette: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22a10 10 0 1 1 10-10c0 2.5-2 3.5-4 3.5h-2a2 2 0 0 0-2 2c0 1 .5 1.5.5 2.5A2.5 2.5 0 0 1 12 22z"></path><circle cx="7.5" cy="10.5" r="1.2" fill="currentColor"></circle><circle cx="12" cy="7.5" r="1.2" fill="currentColor"></circle><circle cx="16.5" cy="10.5" r="1.2" fill="currentColor"></circle></svg>`,
  code: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 7-5 5 5 5"></path><path d="m16 7 5 5-5 5"></path><path d="m13 4-2 16"></path></svg>`,
  cart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1.6"></circle><circle cx="19" cy="21" r="1.6"></circle><path d="M2.5 3h2l2.6 12.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L22 7H6"></path></svg>`,
  rocket: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg>`,
  ux: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8"></path><path d="M12 17v4"></path><path d="m9 10-1.5 1.5L9 13"></path><path d="m15 10 1.5 1.5L15 13"></path></svg>`,
  apps: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect x="14" y="12" width="7" height="9" rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect></svg>`,
  gauge: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 14 16 10"></path><path d="M20.4 20.4A10 10 0 1 0 3.6 20.4"></path><path d="M8.4 17.2a5 5 0 1 1 7.2 0"></path></svg>`,
  seo: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path><path d="m8.5 11 1.8 1.8 3.7-3.6"></path></svg>`,
  social: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 18-7-7 18-2-7-9-4z"></path><path d="m12 15 3-3"></path></svg>`,
  ads: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.2" fill="currentColor"></circle></svg>`,
  content: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path></svg>`,
  brand: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.7 5.9 6.3.7-4.7 4.4 1.2 6.3L12 17l-5.5 3.3 1.2-6.3L3 9.6l6.3-.7L12 3z"></path></svg>`,
  campaign: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4 20-7z"></path><path d="M22 2 11 13"></path></svg>`,
  analytics: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"></path><path d="m7 15 4-4 3 3 5-6"></path></svg>`,
};
---

<section class="section section--dark services" id="services" aria-labelledby="services-heading">
  <div class="grid-bg grid-bg--dark" aria-hidden="true"></div>
  <div class="container">
    <div class="section-heading reveal">
      <span class="tag services__tag">02 / SERVICES</span>
      <h2 id="services-heading">Two disciplines. One digital partner.</h2>
      <p class="lead">
        Everything you need to launch and grow online — from the website itself to the
        marketing that fills it with customers.
      </p>
    </div>

    <div class="services__panels">
      <section class="panel panel--web reveal" aria-labelledby="web-heading">
        <header class="panel__head">
          <span class="panel__code">PILLAR 01</span>
          <h3 id="web-heading">Web Solutions</h3>
          <p>High-performance websites, stores, and applications built to last.</p>
        </header>
        <ul class="panel__grid">
          {webServices.map((service, i) => (
            <li class="panel__card reveal" style={`--reveal-delay: ${(i % 4) * 80}ms`}>
              <span class="panel__num" aria-hidden="true">{service.number}</span>
              <span class="panel__icon" aria-hidden="true" set:html={icons[service.icon]}></span>
              <h4>{service.title}</h4>
              <p>{service.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="panel panel--marketing reveal" aria-labelledby="marketing-heading">
        <header class="panel__head">
          <span class="panel__code">PILLAR 02</span>
          <h3 id="marketing-heading">Digital Marketing</h3>
          <p>Strategies that attract the right audience and turn it into revenue.</p>
        </header>
        <ul class="panel__grid">
          {marketingServices.map((service, i) => (
            <li class="panel__card reveal" style={`--reveal-delay: ${(i % 4) * 80}ms`}>
              <span class="panel__num" aria-hidden="true">{service.number}</span>
              <span class="panel__icon" aria-hidden="true" set:html={icons[service.icon]}></span>
              <h4>{service.title}</h4>
              <p>{service.text}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</section>

<style>
  .services__tag {
    margin-bottom: 18px;
  }

  .services__panels {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 5vw, 48px);
  }

  .panel {
    --accent: var(--color-primary-500);
    --accent-strong: #3b82f6;
    position: relative;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.02);
    padding: clamp(24px, 4vw, 40px);
    overflow: hidden;
  }

  .panel--marketing {
    --accent: var(--color-accent);
    --accent-strong: var(--color-accent);
  }

  .panel::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-strong), transparent 70%);
  }

  .panel__head {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: clamp(24px, 3vw, 32px);
  }

  .panel__code {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: var(--accent-strong);
  }

  .panel__head h3 {
    color: var(--color-white);
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
  }

  .panel__head p {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.95rem;
  }

  .panel__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 2vw, 22px);
  }

  .panel__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-md);
    background: rgba(15, 23, 42, 0.5);
    transition: transform var(--transition), border-color var(--transition),
      background var(--transition);
  }

  .panel__card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
    background: rgba(30, 58, 138, 0.18);
  }

  .panel--marketing .panel__card:hover {
    background: rgba(249, 115, 22, 0.1);
  }

  .panel__num {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.35);
  }

  .panel__icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-dark);
    color: var(--accent-strong);
    background: rgba(255, 255, 255, 0.03);
    margin-top: 2px;
    transition: background var(--transition), color var(--transition);
  }

  .panel__card:hover .panel__icon {
    background: var(--accent-strong);
    color: var(--color-white);
  }

  .panel__icon svg {
    width: 22px;
    height: 22px;
  }

  .panel__card h4 {
    color: var(--color-white);
    font-size: 1rem;
    margin-top: 6px;
  }

  .panel__card p {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
  }

  @media (max-width: 1000px) {
    .panel__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .panel__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
