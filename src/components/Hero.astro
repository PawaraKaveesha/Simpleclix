---
const label = 'DIGITAL SOLUTIONS / 2026';
---

<section class="hero" id="home" aria-labelledby="hero-heading">
  <div class="grid-bg grid-bg--dark" aria-hidden="true"></div>
  <div class="net-line hero__net-1" aria-hidden="true"></div>
  <div class="net-line net-line--accent hero__net-2" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content reveal">
      <span class="tag hero__tag">{label}</span>
      <h1 id="hero-heading">
        Build Digital.
        <span class="hero__accent">Grow Online.</span>
      </h1>
      <p class="hero__lead">
        We design high-performance websites and execute digital marketing strategies
        that turn online presence into measurable business growth.
      </p>
      <div class="hero__actions">
        <a class="btn btn--accent" href="#services">
          Explore Services
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
        <a class="btn btn--outline-light" href="#portfolio">View Our Work</a>
      </div>

      <ul class="hero__chips" aria-label="What Simpleclix covers">
        <li><span class="status-dot" aria-hidden="true"></span>WEB SOLUTIONS</li>
        <li><span class="status-dot status-dot--orange pulse-accent" aria-hidden="true"></span>DIGITAL MARKETING</li>
      </ul>
    </div>

    <div class="hero__visual reveal" style="--reveal-delay: 150ms">
      <span class="status-chip status-chip--dark hero__sys-chip">
        <span class="status-dot" aria-hidden="true"></span>
        SYSTEM / ONLINE
      </span>

      <div class="hero__panel">
        <svg
          class="hero__svg"
          viewBox="0 0 540 440"
          role="img"
          aria-label="Technical diagram showing how website, SEO, and social channels connect into traffic and conversions"
        >
          <g stroke="rgba(148,163,184,0.16)" stroke-width="1">
            <line x1="0" y1="110" x2="540" y2="110" />
            <line x1="0" y1="220" x2="540" y2="220" />
            <line x1="0" y1="330" x2="540" y2="330" />
            <line x1="180" y1="0" x2="180" y2="440" />
            <line x1="360" y1="0" x2="360" y2="440" />
          </g>

          <g stroke="rgba(255,255,255,0.25)" stroke-width="1.5">
            <line x1="85" y1="64" x2="205" y2="166" />
            <line x1="270" y1="64" x2="245" y2="166" />
            <line x1="455" y1="64" x2="285" y2="166" />
            <line x1="255" y1="222" x2="390" y2="316" />
          </g>

          <g class="vis-pulse">
            <circle cx="150" cy="118" r="4" fill="#2563eb" />
            <circle cx="260" cy="115" r="4" fill="#f97316" />
            <circle cx="360" cy="122" r="4" fill="#2563eb" />
            <circle cx="322" cy="270" r="4" fill="#f97316" />
          </g>

          <g font-family="JetBrains Mono, monospace" font-size="11" letter-spacing="1.5">
            <g>
              <rect x="10" y="16" width="150" height="48" rx="6" fill="rgba(255,255,255,0.04)" stroke="rgba(148,163,184,0.35)" />
              <circle cx="30" cy="40" r="4" fill="#34d399" />
              <text x="46" y="44" fill="#e2e8f0">WEBSITE</text>
            </g>
            <g>
              <rect x="195" y="16" width="150" height="48" rx="6" fill="rgba(255,255,255,0.04)" stroke="rgba(148,163,184,0.35)" />
              <circle cx="215" cy="40" r="4" fill="#f97316" />
              <text x="231" y="44" fill="#e2e8f0">SEO</text>
            </g>
            <g>
              <rect x="380" y="16" width="150" height="48" rx="6" fill="rgba(255,255,255,0.04)" stroke="rgba(148,163,184,0.35)" />
              <circle cx="400" cy="40" r="4" fill="#34d399" />
              <text x="416" y="44" fill="#e2e8f0">SOCIAL</text>
            </g>
            <g>
              <rect x="140" y="170" width="230" height="52" rx="6" fill="rgba(255,255,255,0.05)" stroke="rgba(59,130,246,0.5)" />
              <circle cx="160" cy="196" r="4" fill="#3b82f6" />
              <text x="176" y="200" fill="#ffffff">TRAFFIC</text>
              <path d="M210 214 C 240 202, 268 206, 296 192 S 330 186, 352 170" fill="none" stroke="#3b82f6" stroke-width="2" />
            </g>
            <g>
              <rect x="330" y="320" width="190" height="52" rx="6" fill="rgba(255,255,255,0.05)" stroke="rgba(249,115,22,0.55)" />
              <circle cx="350" cy="346" r="4" fill="#f97316" />
              <text x="366" y="350" fill="#ffffff">CONVERSIONS</text>
              <path d="M408 348 l10 -7 10 7 12 -9 14 5" fill="none" stroke="#f97316" stroke-width="2" />
            </g>
          </g>

          <circle cx="470" cy="180" r="5" fill="none" stroke="#f97316" stroke-width="1.5" stroke-dasharray="2 3" />
          <circle cx="30" cy="300" r="5" fill="none" stroke="#3b82f6" stroke-width="1.5" stroke-dasharray="2 3" />
        </svg>
      </div>

      <span class="status-chip status-chip--dark hero__perf-chip">
        PERFORMANCE / OPTIMIZED
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-dark);
    padding-top: calc(var(--header-height) + clamp(56px, 8vw, 96px));
    padding-bottom: clamp(56px, 8vw, 96px);
    color: var(--color-white);
  }

  .hero__net-1 {
    width: 46%;
    top: 28%;
    left: -10%;
    transform: rotate(-8deg);
  }

  .hero__net-2 {
    width: 38%;
    bottom: 16%;
    right: -8%;
    transform: rotate(10deg);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }

  .hero__tag {
    margin-bottom: 22px;
  }

  .hero h1 {
    color: var(--color-white);
    margin-bottom: 22px;
  }

  .hero__accent {
    color: var(--color-accent);
  }

  .hero__lead {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.1rem;
    margin-bottom: 32px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 40px;
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }

  .hero__chips li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .hero__sys-chip {
    align-self: flex-start;
  }

  .hero__perf-chip {
    align-self: flex-end;
  }

  .hero__panel {
    width: 100%;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
    padding: clamp(14px, 2vw, 22px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }

  .hero__svg {
    width: 100%;
    height: auto;
  }

  .vis-pulse circle {
    animation: vis-pulse 2.6s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .vis-pulse circle:nth-child(2) {
    animation-delay: 0.6s;
  }

  .vis-pulse circle:nth-child(3) {
    animation-delay: 1.2s;
  }

  .vis-pulse circle:nth-child(4) {
    animation-delay: 1.8s;
  }

  @keyframes vis-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.85);
    }
    50% {
      opacity: 1;
      transform: scale(1.25);
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      max-width: 520px;
      margin-inline: auto;
    }
  }
</style>
