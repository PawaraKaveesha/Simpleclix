---
const label = 'DIGITAL SOLUTIONS / SIMPLECLIX';
---

<section class="hero" id="home" aria-labelledby="hero-heading">
  <!-- YouTube Video Background (lazy-loaded on desktop only) -->
  <div class="hero__video-wrap" id="hero-video-wrap" aria-hidden="true"></div>

  <!-- Overlay layers -->
  <div class="hero__overlay hero__overlay--dark" aria-hidden="true"></div>
  <div class="hero__overlay hero__overlay--gradient" aria-hidden="true"></div>
  <div class="hero__overlay hero__overlay--accent" aria-hidden="true"></div>

  <!-- Technical grid background -->
  <div class="hero__grid-bg" aria-hidden="true">
    <svg class="hero__grid-svg" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice">
      <!-- Grid lines -->
      <g stroke="rgba(148,163,184,0.08)" stroke-width="1">
        <line x1="0" y1="100" x2="1200" y2="100" />
        <line x1="0" y1="200" x2="1200" y2="200" />
        <line x1="0" y1="300" x2="1200" y2="300" />
        <line x1="0" y1="400" x2="1200" y2="400" />
        <line x1="0" y1="500" x2="1200" y2="500" />
        <line x1="0" y1="600" x2="1200" y2="600" />
        <line x1="0" y1="700" x2="1200" y2="700" />
        <line x1="150" y1="0" x2="150" y2="800" />
        <line x1="300" y1="0" x2="300" y2="800" />
        <line x1="450" y1="0" x2="450" y2="800" />
        <line x1="600" y1="0" x2="600" y2="800" />
        <line x1="750" y1="0" x2="750" y2="800" />
        <line x1="900" y1="0" x2="900" y2="800" />
        <line x1="1050" y1="0" x2="1050" y2="800" />
      </g>
      <!-- Glowing nodes -->
      <g class="hero__nodes">
        <circle cx="300" cy="200" r="3" fill="#3b82f6" opacity="0.6" />
        <circle cx="600" cy="100" r="2.5" fill="#f97316" opacity="0.5" />
        <circle cx="900" cy="300" r="3" fill="#3b82f6" opacity="0.6" />
        <circle cx="450" cy="500" r="2" fill="#f97316" opacity="0.4" />
        <circle cx="750" cy="400" r="2.5" fill="#3b82f6" opacity="0.5" />
        <circle cx="150" cy="600" r="2" fill="#3b82f6" opacity="0.4" />
        <circle cx="1050" cy="200" r="2.5" fill="#f97316" opacity="0.5" />
      </g>
      <!-- Circuit / network lines -->
      <g stroke="rgba(59,130,246,0.12)" stroke-width="1" fill="none">
        <path d="M300 200 L450 200 L450 300 L600 300" />
        <path d="M600 100 L600 200 L750 200" />
        <path d="M900 300 L900 400 L750 400" />
      </g>
      <g stroke="rgba(249,115,22,0.10)" stroke-width="1" fill="none">
        <path d="M150 600 L300 600 L300 500 L450 500" />
        <path d="M1050 200 L1050 300 L900 300" />
      </g>
      <!-- Node glow rings -->
      <circle cx="300" cy="200" r="8" fill="none" stroke="rgba(59,130,246,0.15)" stroke-width="1" class="hero__node-ring" />
      <circle cx="900" cy="300" r="8" fill="none" stroke="rgba(59,130,246,0.15)" stroke-width="1" class="hero__node-ring hero__node-ring--delay1" />
      <circle cx="600" cy="100" r="7" fill="none" stroke="rgba(249,115,22,0.12)" stroke-width="1" class="hero__node-ring hero__node-ring--delay2" />
    </svg>
  </div>

  <div class="container hero__inner">
    <div class="hero__content reveal">
      <span class="tag hero__tag">{label}</span>
      <h1 id="hero-heading">
        Build Digital.
        <span class="hero__accent">Grow Online.</span>
      </h1>
      <p class="hero__lead">
        We create high-performance web solutions and data-driven digital marketing
        strategies that help businesses build their presence and grow online.
      </p>

      <div class="hero__categories">
        <span class="hero__category">
          <span class="status-dot" aria-hidden="true"></span>
          WEB SOLUTIONS
        </span>
        <span class="hero__category">
          <span class="status-dot status-dot--orange pulse-accent" aria-hidden="true"></span>
          DIGITAL MARKETING
        </span>
      </div>

      <div class="hero__actions">
        <a class="btn btn--accent" href="#services">
          Explore Services
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
        <a class="btn btn--outline-light" href="#portfolio">View Our Work</a>
      </div>

      <span class="hero__status-indicator">
        <span class="status-dot" aria-hidden="true"></span>
        SYSTEM ONLINE
      </span>
    </div>

    <div class="hero__visual reveal" style="--reveal-delay: 150ms">
      <!-- HUD Elements -->
      <div class="hero__hud">
        <div class="hero__hud-item hero__hud-item--web">
          <span class="hero__hud-label">WEB / 98%</span>
          <div class="hero__hud-bar">
            <div class="hero__hud-bar-fill" style="--bar-width: 98%"></div>
          </div>
        </div>

        <div class="hero__hud-item hero__hud-item--seo">
          <span class="hero__hud-label">SEO / +42%</span>
          <div class="hero__hud-bar">
            <div class="hero__hud-bar-fill hero__hud-bar-fill--accent" style="--bar-width: 72%"></div>
          </div>
        </div>

        <div class="hero__hud-item hero__hud-item--social">
          <span class="hero__hud-label">
            <span class="status-dot" style="width:5px;height:5px;" aria-hidden="true"></span>
            SOCIAL / ACTIVE
          </span>
        </div>

        <div class="hero__hud-item hero__hud-item--perf">
          <span class="hero__hud-label">PERFORMANCE / OPTIMIZED</span>
        </div>
      </div>

      <!-- Technical Diagram Panel -->
      <div class="hero__panel">
        <svg
          class="hero__svg"
          viewBox="0 0 540 440"
          role="img"
          aria-label="Technical diagram showing how website, SEO, and social channels connect into traffic and conversions"
        >
          <g stroke="rgba(148,163,184,0.16)" stroke-width="1">
            <line x1="0" y1="110" x2="540" y2="110" />
            <line x1="0" y1="220" x2="540" y2="220" />
            <line x1="0" y1="330" x2="540" y2="330" />
            <line x1="180" y1="0" x2="180" y2="440" />
            <line x1="360" y1="0" x2="360" y2="440" />
          </g>

          <g stroke="rgba(255,255,255,0.25)" stroke-width="1.5">
            <line x1="85" y1="64" x2="205" y2="166" />
            <line x1="270" y1="64" x2="245" y2="166" />
            <line x1="455" y1="64" x2="285" y2="166" />
            <line x1="255" y1="222" x2="390" y2="316" />
          </g>

          <g class="vis-pulse">
            <circle cx="150" cy="118" r="4" fill="#2563eb" />
            <circle cx="260" cy="115" r="4" fill="#f97316" />
            <circle cx="360" cy="122" r="4" fill="#2563eb" />
            <circle cx="322" cy="270" r="4" fill="#f97316" />
          </g>

          <g font-family="JetBrains Mono, monospace" font-size="11" letter-spacing="1.5">
            <g>
              <rect x="10" y="16" width="150" height="48" rx="6" fill="rgba(255,255,255,0.04)" stroke="rgba(148,163,184,0.35)" />
              <circle cx="30" cy="40" r="4" fill="#34d399" />
              <text x="46" y="44" fill="#e2e8f0">WEBSITE</text>
            </g>
            <g>
              <rect x="195" y="16" width="150" height="48" rx="6" fill="rgba(255,255,255,0.04)" stroke="rgba(148,163,184,0.35)" />
              <circle cx="215" cy="40" r="4" fill="#f97316" />
              <text x="231" y="44" fill="#e2e8f0">SEO</text>
            </g>
            <g>
              <rect x="380" y="16" width="150" height="48" rx="6" fill="rgba(255,255,255,0.04)" stroke="rgba(148,163,184,0.35)" />
              <circle cx="400" cy="40" r="4" fill="#34d399" />
              <text x="416" y="44" fill="#e2e8f0">SOCIAL</text>
            </g>
            <g>
              <rect x="140" y="170" width="230" height="52" rx="6" fill="rgba(255,255,255,0.05)" stroke="rgba(59,130,246,0.5)" />
              <circle cx="160" cy="196" r="4" fill="#3b82f6" />
              <text x="176" y="200" fill="#ffffff">TRAFFIC</text>
              <path d="M210 214 C 240 202, 268 206, 296 192 S 330 186, 352 170" fill="none" stroke="#3b82f6" stroke-width="2" />
            </g>
            <g>
              <rect x="330" y="320" width="190" height="52" rx="6" fill="rgba(255,255,255,0.05)" stroke="rgba(249,115,22,0.55)" />
              <circle cx="350" cy="346" r="4" fill="#f97316" />
              <text x="366" y="350" fill="#ffffff">CONVERSIONS</text>
              <path d="M408 348 l10 -7 10 7 12 -9 14 5" fill="none" stroke="#f97316" stroke-width="2" />
            </g>
          </g>

          <circle cx="470" cy="180" r="5" fill="none" stroke="#f97316" stroke-width="1.5" stroke-dasharray="2 3" />
          <circle cx="30" cy="300" r="5" fill="none" stroke="#3b82f6" stroke-width="1.5" stroke-dasharray="2 3" />
        </svg>
      </div>

      <span class="status-chip status-chip--dark hero__perf-chip">
        DIGITAL / 2026
      </span>
    </div>
  </div>
</section>

<script>
  // Lazy-load YouTube video on desktop only, respecting reduced motion
  (function () {
    const isDesktop = window.matchMedia('(min-width: 769px)').matches;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (isDesktop && !prefersReducedMotion) {
      const loadVideo = () => {
        const wrap = document.getElementById('hero-video-wrap');
        if (!wrap || wrap.querySelector('iframe')) return;

        const iframe = document.createElement('iframe');
        iframe.src =
          'https://www.youtube.com/embed/pQpFebyALV0?autoplay=1&mute=1&loop=1&controls=0&showinfo=0&rel=0&playlist=pQpFebyALV0&playsinline=1&modestbranding=1&iv_load_policy=3&disablekb=1';
        iframe.allow = 'autoplay; encrypted-media';
        iframe.setAttribute('loading', 'lazy');
        iframe.setAttribute('tabindex', '-1');
        iframe.setAttribute('aria-hidden', 'true');
        iframe.title = 'Background video';
        iframe.style.cssText =
          'position:absolute;top:50%;left:50%;width:120vw;height:120vh;min-width:120%;min-height:120%;transform:translate(-50%,-50%);border:0;pointer-events:none;opacity:0;transition:opacity 1.2s ease;';

        wrap.appendChild(iframe);

        // Fade in once loaded
        iframe.addEventListener('load', () => {
          iframe.style.opacity = '1';
        });
      };

      // Use requestIdleCallback if available, otherwise setTimeout
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadVideo, { timeout: 3000 });
      } else {
        setTimeout(loadVideo, 1500);
      }
    }
  })();
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-dark);
    padding-top: calc(var(--header-height) + clamp(56px, 8vw, 96px));
    padding-bottom: clamp(56px, 8vw, 96px);
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    color: var(--color-white);
  }

  /* Video background container */
  .hero__video-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Overlay layers */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero__overlay--dark {
    background: rgba(10, 15, 36, 0.82);
  }

  .hero__overlay--gradient {
    background: linear-gradient(
      135deg,
      rgba(30, 58, 138, 0.4) 0%,
      rgba(37, 99, 235, 0.15) 50%,
      rgba(15, 23, 42, 0.3) 100%
    );
  }

  .hero__overlay--accent {
    background: radial-gradient(
      ellipse 60% 50% at 70% 80%,
      rgba(249, 115, 22, 0.08),
      transparent 60%
    );
  }

  /* Technical grid background */
  .hero__grid-bg {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.7;
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 40%, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse 90% 80% at 50% 40%, #000 10%, transparent 70%);
  }

  .hero__grid-svg {
    width: 100%;
    height: 100%;
  }

  /* Node pulse animation */
  .hero__nodes circle {
    animation: hero-node-pulse 3.5s ease-in-out infinite;
  }

  .hero__nodes circle:nth-child(2) { animation-delay: 0.5s; }
  .hero__nodes circle:nth-child(3) { animation-delay: 1.0s; }
  .hero__nodes circle:nth-child(4) { animation-delay: 1.5s; }
  .hero__nodes circle:nth-child(5) { animation-delay: 2.0s; }
  .hero__nodes circle:nth-child(6) { animation-delay: 2.5s; }
  .hero__nodes circle:nth-child(7) { animation-delay: 3.0s; }

  @keyframes hero-node-pulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.8; }
  }

  /* Node ring expand animation */
  .hero__node-ring {
    animation: hero-ring-expand 4s ease-out infinite;
  }

  .hero__node-ring--delay1 { animation-delay: 1.3s; }
  .hero__node-ring--delay2 { animation-delay: 2.6s; }

  @keyframes hero-ring-expand {
    0% { r: 8; opacity: 0.2; }
    50% { r: 16; opacity: 0; }
    100% { r: 8; opacity: 0; }
  }

  /* Hero inner layout */
  .hero__inner {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }

  .hero__tag {
    margin-bottom: 22px;
  }

  .hero h1 {
    color: var(--color-white);
    margin-bottom: 22px;
  }

  .hero__accent {
    color: var(--color-accent);
  }

  .hero__lead {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.1rem;
    margin-bottom: 28px;
  }

  /* Category indicators */
  .hero__categories {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-bottom: 32px;
  }

  .hero__category {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 32px;
  }

  /* Status indicator */
  .hero__status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-full);
    padding: 6px 14px;
    background: rgba(255, 255, 255, 0.03);
  }

  /* Visual / HUD side */
  .hero__visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  /* HUD Elements */
  .hero__hud {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 100%;
    margin-bottom: 8px;
  }

  .hero__hud-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 14px;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .hero__hud-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__hud-bar {
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .hero__hud-bar-fill {
    height: 100%;
    width: var(--bar-width, 50%);
    border-radius: 2px;
    background: linear-gradient(90deg, #3b82f6, #60a5fa);
    animation: hero-bar-fill 2s ease-out forwards;
    transform-origin: left;
  }

  .hero__hud-bar-fill--accent {
    background: linear-gradient(90deg, #f97316, #fb923c);
  }

  @keyframes hero-bar-fill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .hero__perf-chip {
    align-self: flex-end;
  }

  .hero__panel {
    width: 100%;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
    padding: clamp(14px, 2vw, 22px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }

  .hero__svg {
    width: 100%;
    height: auto;
  }

  .vis-pulse circle {
    animation: vis-pulse 2.6s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .vis-pulse circle:nth-child(2) { animation-delay: 0.6s; }
  .vis-pulse circle:nth-child(3) { animation-delay: 1.2s; }
  .vis-pulse circle:nth-child(4) { animation-delay: 1.8s; }

  @keyframes vis-pulse {
    0%, 100% {
      opacity: 0.35;
      transform: scale(0.85);
    }
    50% {
      opacity: 1;
      transform: scale(1.25);
    }
  }

  /* Mobile: hide video, single column */
  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--header-height) + clamp(40px, 6vw, 64px));
      padding-bottom: clamp(40px, 6vw, 64px);
    }

    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      max-width: 520px;
      margin-inline: auto;
    }
  }

  @media (max-width: 768px) {
    .hero__video-wrap {
      display: none;
    }

    .hero__hud {
      grid-template-columns: 1fr;
    }
  }

  /* Reduced motion: disable all animations and video */
  @media (prefers-reduced-motion: reduce) {
    .hero__video-wrap {
      display: none;
    }

    .hero__nodes circle,
    .hero__node-ring,
    .vis-pulse circle,
    .hero__hud-bar-fill {
      animation: none;
    }

    .hero__hud-bar-fill {
      transform: scaleX(1);
    }

    .hero__node-ring {
      opacity: 0;
    }
  }
</style>
